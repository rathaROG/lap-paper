  "saved_probe_source": "\"\"\"Compare exact extreme-scale residuals against the saved old payload.\"\"\"\nfrom fractions import Fraction\nimport json\nfrom pathlib import Path\nimport sys\nimport numpy as np\nfrom scipy.optimize import linear_sum_assignment\n\nROOT=Path(__file__).resolve().parent\npayload=ROOT/'payload' if sys.argv[1]=='fixed' else ROOT.parent/'gated-geometric/payloads/current'\nsys.path.insert(0,str(payload));import lap\nhigh=float(2**48);small=2**-12\nrecords=[]\nfor shape,a in [('rectangular',np.array([[high,2*small,high],[high,small,high]],dtype=np.float32)),\n                ('square',np.array([[high,high],[small,2*small]],dtype=np.float32))]:\n    expected=Fraction.from_float(high)+Fraction.from_float(small)\n    for name in ['lapjvsa','lapjvr','lapjvh','scipy']:\n        if name=='scipy':pairs=np.column_stack(linear_sum_assignment(a))\n        else:\n            kwargs=dict(extend_cost=True,return_cost=False)\n            if name!='lapjvsa':kwargs['output']='pairs'\n            pairs=getattr(lap,name)(a,**kwargs)\n        actual=sum((Fraction.from_float(float(a[i,j])) for i,j in pairs),Fraction())\n        records.append(dict(build=sys.argv[1],family=name,shape=shape,high=high,small=small,\n                            pairs=pairs.tolist(),exact_gap=str(actual-expected)))\nprint(json.dumps(records,indent=2))\n",
