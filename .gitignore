# Python bytecode, caches and environments
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

# Scratch work, drafts and interrupted or superseded runs
tmp/
*.tmp

# Local LaTeX build by-products. The verified arXiv build runs under tmp/arxiv/;
# retain the generated main.bbl as part of the canonical submission sources.
latex/*.aux
latex/*.bbl
!latex/main.bbl
latex/*.blg
latex/*.fdb_latexmk
latex/*.fls
latex/*.log
latex/*.out
latex/*.synctex.gz
latex/*.toc

# Package benchmark runs kept locally with the archive; they are not paper evidence
archive/*/benchmark-results/
archive/*/benchmarks/

# Editors and operating systems
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
